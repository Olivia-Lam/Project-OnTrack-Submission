# OnTrack configuration. Copy this file to ".env" in the same folder and fill it in.
# NEVER commit .env - it is git-ignored. Values below are intentionally empty.

# ---- REQUIRED for journey planning and address search (free) --------------------------------
# Register at https://www.onemap.gov.sg/apidocs/register  (use your EMAIL ADDRESS as the username)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ---- RECOMMENDED (free): LTA DataMall AccountKey ---------------------------------------------
# Live rail alerts, crowd colours on the map, bicycle-parking racks, bus stops.
# Request access at https://datamall.lta.gov.sg  (the key is 24 characters ending in "==", emailed on approval).
# Without it the app falls back to public sources (see README) and says so on screen.
LTA_ACCOUNT_KEY=

# ---- OPTIONAL --------------------------------------------------------------------------------
# Port the server listens on (Cloud Run sets this itself).
PORT=4000
# Keep server-side times in Singapore time.
TZ=Asia/Singapore
# Only needed if the frontend is hosted on a different origin than the API.
CORS_ORIGIN=

# Demonstrate a disruption on a day when nothing is disrupted: point this at a replay file. The app labels
# replayed data as a replay everywhere it is shown.
#   app/backend/data/captured/synthetic-nel-fault.json     SYNTHETIC test incident on the North East Line
#   app/backend/data/captured/lta-train-alerts-real.json   REAL captured LTA response (no disruption)
ALERTS_REPLAY=

# Camera-based platform crowd service (see smartgs/). Leave empty: door crowding is then simulated and labelled as such.
SMARTGS_BASE_URL=
SMARTGS_API_KEY=
SMARTGS_STATION_CODE=

# Not used by any screen today; only the optional /api/journey/recommend endpoint reads it.
AGNES_API_KEY=
